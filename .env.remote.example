# Reach the local stack from another device (README "Access from another
# device", TODO.md D19). This is a LAYER on top of .env, not a full env file:
#
#   docker compose --env-file .env --env-file .env.remote up -d -V
#
# `scripts/remote-up.sh lan|ngrok` writes .env.remote from this file; by hand,
# copy it to .env.remote (git-ignored) and edit the two lines below.
#
# WEB = public URL that reaches port 3000, API = public URL that reaches 8000.
# LAN example:   WEB=http://192.168.1.42:3000       API=http://192.168.1.42:8000
# ngrok example: WEB=https://xxxx.ngrok-free.app    API=https://yyyy.ngrok-free.app
WEB=http://192.168.1.42:3000
API=http://192.168.1.42:8000

# Everything below derives from the two lines above (Compose expands ${WEB}
# and ${API} inside this file). The session cookie is bound to NEXTAUTH_URL,
# so the host must ALSO open the stack at ${WEB}, not at localhost.
NEXTAUTH_URL=${WEB}
FRONTEND_URL=${WEB}
CORS_ORIGINS=http://localhost:3000,${WEB}
STRIPE_SUCCESS_URL=${WEB}/dashboard?pagamento=sucesso
STRIPE_CANCEL_URL=${WEB}/dashboard?pagamento=cancelado
NEXT_PUBLIC_API_URL=${API}/api/v1
MEDIA_BASE_URL=${API}/media
STRIPE_STUB_CHECKOUT_BASE_URL=${API}
