# The single template for every variable this project reads — both services.
# Copy it to `.env` and fill in real values before running docker-compose.
# `.env` is gitignored — never commit it.
#
# Running the backend outside Docker? `cp ../.env.example backend/.env` — the
# backend loads `.env` from its own working directory. There is deliberately no
# second template under `backend/`: keeping two copies is how the Stripe
# variables ended up documented in only one of them.

# ── Backend JWT signing key (HS256) ──────────────────────────────────────
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters.
SECRET_KEY=dev-secret-key-change-this-in-production-min-32-chars

# ── NextAuth session encryption key ──────────────────────────────────────
# Generate one with:  openssl rand -base64 48
NEXTAUTH_SECRET=dev-nextauth-secret-change-in-production

# ── Database (optional — defaults baked into docker-compose work locally) ──
# Inside Docker the host is the `db` service, never `localhost` (CLAUDE.md §6.3).
# Outside Docker, drop the `db` host for `localhost` — that is what the backend
# already defaults to.
# DATABASE_URL=postgresql+asyncpg://spacerental:spacerental@db:5432/spacerental

# ── Token lifetime (minutes; 1440 = 24h) ─────────────────────────────────
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Allowed browser origins for the API (comma-separated) ────────────────
# docker-compose pins this to the frontend service's URL; set it only when
# running the backend outside the compose stack on a different port.
# CORS_ORIGINS=http://localhost:3000

# ── Rate limiting (in-process, per client IP) ────────────────────────────
# Two independent tiers: `auth` guards the credential endpoints (each accepted
# request costs an Argon2 hash), `public` guards unauthenticated reads.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH_MAX_REQUESTS=10
# RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# RATE_LIMIT_PUBLIC_MAX_REQUESTS=120
# RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60
#
# Enable ONLY when a reverse proxy you control (nginx/Traefik/ALB) overwrites
# X-Forwarded-For. With no proxy in front, a client can spoof the header and
# bypass throttling by rotating the value.
# RATE_LIMIT_TRUST_FORWARDED_FOR=false

# ── Payments ─────────────────────────────────────────────────────────────
# stub = run the whole checkout → webhook → confirmed flow locally with no
#        Stripe account, no credentials and no network calls (default).
# live = talk to the real Stripe API. STRIPE_SECRET_KEY and
#        STRIPE_WEBHOOK_SECRET then become mandatory: the backend refuses to
#        boot without them rather than quietly falling back to the stub.
STRIPE_MODE=stub

# Only read in live mode. Get them from the Stripe dashboard, and the webhook
# secret from `stripe listen --forward-to localhost:8000/api/v1/webhooks/stripe`.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# In stub mode this defaults to `whsec_stub_local_secret` — set it only if you
# want to sign local webhook payloads with your own secret.
# STRIPE_WEBHOOK_SECRET=whsec_stub_local_secret

# Where Stripe sends the user back after paying.
# STRIPE_CURRENCY=eur
# STRIPE_SUCCESS_URL=http://localhost:3000/dashboard?pagamento=sucesso
# STRIPE_CANCEL_URL=http://localhost:3000/dashboard?pagamento=cancelado

# Stub mode only: the browser-facing base URL of THIS backend, used to build
# the walkable /checkout/stub/{id} page's URL (T10). Like NEXT_PUBLIC_API_URL,
# this is handed to the user's browser rather than called container-to-
# container, so `localhost` is correct even under docker-compose.
# STRIPE_STUB_CHECKOUT_BASE_URL=http://localhost:8000

# ── Email notifications ───────────────────────────────────────────────────
# stub = booking confirmation/cancellation emails are logged and kept
#        in-memory (visible via `docker-compose logs backend`), no account,
#        no credentials, no network calls (default).
# live = send through the real Resend API. RESEND_API_KEY then becomes
#        mandatory: the backend refuses to boot without it rather than
#        quietly falling back to the stub.
EMAIL_MODE=stub

# Experimental weekly series: pending reservations require manual admin handling.
# Keep disabled for customers until series payments and Lisbon/DST support ship.
RECURRING_BOOKINGS_ENABLED=false

# Only read in live mode. Get it from the Resend dashboard.
# RESEND_API_KEY=re_...

# "Display Name <email>" the emails are sent from. Only matters in live mode
# (Resend requires the domain to be verified for anything but their test
# sender), but the stub logs it too so the local content matches production.
# EMAIL_FROM_ADDRESS=EspaçoHora <no-reply@espacohora.pt>

# Base URL used to build links inside outgoing emails (e.g. "cancel this
# booking"). This is handed to the user's mail client, so localhost is
# correct here — unlike backend-to-backend calls (CLAUDE.md §6.3).
# FRONTEND_URL=http://localhost:3000
