# The production `.env` (E02) — every variable docker-compose.prod.yml and the
# two images read on the host. It never lives in the repository or on a
# laptop for long: fill it in, store it with
#
#   aws ssm put-parameter --name /spacerental/prod/env --type SecureString \
#     --value file://.env.production --overwrite
#
# and deploy/deploy.sh writes it to /srv/spacerental/.env (0600) on every
# deploy (docs/runbooks/aws.md, Phase 2). Every change to it is
# `put-parameter` + a re-run of deploy.yml.
#
# With APP_ENV=production the backend refuses to start (backend/app/config.py)
# unless SECRET_KEY is generated and ≥ 32 characters, TEST_HOOKS_ENABLED is
# false, FRONTEND_URL and CORS_ORIGINS are https://, EMAIL_MODE and
# STRIPE_MODE are set explicitly, DATABASE_URL is not localhost and
# MEDIA_ROOT is writable; the frontend refuses the development
# NEXTAUTH_SECRET. The local dress rehearsal of this file is
# scripts/tests/prod-stack.sh.

# ── Deployment kind ──────────────────────────────────────────────────────
# `production` arms the interlock above, keeps the local-only test hooks
# unmounted whatever TEST_HOOKS_ENABLED says, and makes `python -m app.seed`
# refuse to run (use `python -m app.bootstrap`, E03).
APP_ENV=production
TEST_HOOKS_ENABLED=false

# ── Secrets (generate; never reuse a development value) ──────────────────
# Backend JWT signing key (HS256), at least 32 characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# NextAuth session encryption key:
#   openssl rand -base64 48
NEXTAUTH_SECRET=

# ── Addresses ────────────────────────────────────────────────────────────
# The one public address. Caddy serves it (Let's Encrypt), the browser's
# session cookie is bound to it, every link in an email starts with it, and
# the Stripe return URLs and the media URL are derived from FRONTEND_URL
# (D20). CADDY_DOMAIN is the bare host; the other two carry the scheme.
CADDY_DOMAIN=app.flowspace.pt
FRONTEND_URL=https://app.flowspace.pt
NEXTAUTH_URL=https://app.flowspace.pt
# Only a browser that calls the API's origin directly needs CORS; the app
# does not (its calls are same-origin through /backend). Must be https.
CORS_ORIGINS=https://app.flowspace.pt
# What the BROWSER calls: relative, through the frontend's proxy. Inlined
# into the frontend image at build time (deploy.yml passes the same value).
NEXT_PUBLIC_API_URL=/backend/api/v1
# Where the frontend container calls the API: the Compose service name
# (CLAUDE.md §6.3). docker-compose.prod.yml fixes it; listed for the record.
INTERNAL_API_URL=http://backend:8000/api/v1

# ── Database (RDS, E04/E09) ──────────────────────────────────────────────
# NOT HERE. deploy.sh composes DATABASE_URL on every deploy from the app
# role's secret (spacerental/prod/db-app, written once by
# /srv/spacerental/db-bootstrap.sh — runbook 2.4) and the host, port and
# name cloud-init wrote to /etc/spacerental/deploy.env, as
#   postgresql+asyncpg://spacerental_app:<password>@<rds-endpoint>:5432/spacerental?ssl=require
# and appends it to the .env the backend reads. A DATABASE_URL in this file
# makes deploy.sh refuse the deploy: the app never runs as the RDS master
# user, whose password RDS rotates every 7 days.
# uvicorn workers (backend/Dockerfile). Two on a t4g.small. With
# RATE_LIMIT_STORE=postgres (below, N02) the limits are the deployment's
# whatever this number is, and one hold sweeper runs per deployment (N01).
WEB_CONCURRENCY=2

# ── Enrollment ───────────────────────────────────────────────────────────
# Customer sign-up joins this organisation: the slug `python -m app.bootstrap
# --slug …` created (E03). Blank or unknown fails closed (503 on sign-up).
CUSTOMER_ENROLLMENT_ORG_SLUG=flowspace
CUSTOMER_ENROLLMENT_ENABLED=true

# ── Rate limiting (per client IP, counted in PostgreSQL) ─────────────────
# Caddy OVERWRITES X-Forwarded-For with the connecting address (its default
# for untrusted peers), so the first entry is the real client and may be
# trusted here (S12); the Next.js server then appends its own peer (Caddy),
# which RATE_LIMIT_TRUSTED_PROXIES=frontend lets the limiter ignore (D20).
# Both stay as they are behind Caddy; see app/ratelimit.py:client_identity.
# "postgres" (N02): fixed-window counters in the rate_limit_hits table,
# shared by every worker and replica, so a limit below means exactly that
# number. A store the API cannot reach refuses auth and support requests
# (503) and lets public reads through with a WARNING. "memory" is the
# per-process store development runs (every limit × WEB_CONCURRENCY).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE=postgres
RATE_LIMIT_TRUST_FORWARDED_FOR=true
RATE_LIMIT_TRUSTED_PROXIES=frontend
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_MAX_REQUESTS=120
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_MAX_REQUESTS=30
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
RATE_LIMIT_SUPPORT_MAX_REQUESTS=5
RATE_LIMIT_SUPPORT_WINDOW_SECONDS=3600
# One reverse proxy (Caddy) in front of Next.js for /api/csp-report's limiter.
CSP_REPORT_TRUSTED_PROXIES=1

# ── Media (photos, private invoice PDFs) ─────────────────────────────────
# The host directory mounted at the backend's MEDIA_ROOT (/app/media, fixed
# by docker-compose.prod.yml): the EBS data volume cloud-init mounts (E08),
# backed up daily (E06). "local" is the only storage implemented.
MEDIA_STORAGE=local
MEDIA_HOST_DIR=/srv/media
# Browser-facing URL of the photos: empty = <FRONTEND_URL>/backend/media.
MEDIA_BASE_URL=

# ── Payments (Stripe) ────────────────────────────────────────────────────
# Explicit, always: `stub` runs the walkable local checkout (no money
# moves — fine for the first deploy and the smoke checklist, logged at
# WARNING), `live` needs both keys and the webhook endpoint
# https://app.flowspace.pt/backend/api/v1/webhooks/stripe (runbook, Phase 4).
STRIPE_MODE=stub
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
# Empty = derived from FRONTEND_URL (D20).
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_STUB_CHECKOUT_BASE_URL=

# ── Email (Resend) ───────────────────────────────────────────────────────
# Explicit, always: `stub` keeps every message in the backend's log (`docker
# compose logs backend | grep "STUB EMAIL"`), `live` needs RESEND_API_KEY and
# the sender's domain verified at Resend (README "Pôr os emails a funcionar").
EMAIL_MODE=stub
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=FlowSpace <no-reply@flowspace.pt>
SUPPORT_INBOX_EMAIL=geral+support@flowspace.pt

# ── Smart locks (Seam) ───────────────────────────────────────────────────
# Live operation is gated until O04 ships; stub codes live in process memory.
SEAM_MODE=stub
SEAM_API_KEY=
SEAM_DEVICE_ID_MAP=
SEAM_TIMEOUT_SECONDS=10

# ── Product settings (the dev defaults; change deliberately) ─────────────
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RECURRING_BOOKINGS_ENABLED=false
BOOKING_HOLD_MINUTES=15
BOOKING_MAX_ADVANCE_DAYS=30
CANCELLATION_CREDIT_VALIDITY_DAYS=365
HOLD_SWEEP_INTERVAL_SECONDS=60
LANDING_CACHE_SECONDS=0
# Optional phone line in "Onde estamos" (V06); empty = no line. Inlined into
# the frontend image at build time.
CONTACT_PHONE=

# ── Host and logs (E01/E08) ──────────────────────────────────────────────
# docker-compose.prod.yml's logging driver; production adds the awslogs
# overlay, which reads AWS_REGION and the log group Terraform created.
LOG_DRIVER=awslogs
AWS_REGION=eu-west-1
AWS_LOG_GROUP=/spacerental/prod
