NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-nextauth-secret-change-in-production
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Mirrors the backend's BOOKING_MAX_ADVANCE_DAYS for the calendar's hint (H01).
NEXT_PUBLIC_BOOKING_MAX_ADVANCE_DAYS=30
# Mirrors the backend's CANCELLATION_CREDIT_VALIDITY_DAYS for the cancel dialog (K01).
NEXT_PUBLIC_CANCELLATION_CREDIT_VALIDITY_DAYS=365
# Optional phone line in "Onde estamos" (V06); leave empty for no line.
NEXT_PUBLIC_CONTACT_PHONE=
